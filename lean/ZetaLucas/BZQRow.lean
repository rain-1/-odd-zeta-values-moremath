/-- `Bmid`, evaluated from its sparse table. -/
def Bmid (n k l : ℚ) : ℚ := eval BmidP n k l

/-- `[(n+1−k)(n+2−k)(n+3−k)]²` — the factor of `B` that cancels `Φ`'s interior `k`-poles. -/
def Kfac (n k _l : ℚ) : ℚ := (n + 1 - k) ^ 2 * (n + 2 - k) ^ 2 * (n + 3 - k) ^ 2

/-- `B(n,k,l)/l³ = Kfac·Bmid`. -/
def Bcore (n k l : ℚ) : ℚ := Kfac n k l * Bmid n k l


/-- `A(n,k,l) = k³·Acore` — the `k`-cofactor numerator (`r_num` of `Qrow_phicert.m`). -/
def Anum (n k l : ℚ) : ℚ := k ^ 3 * Acore n k l

/-- `B(n,k,l) = l³·Bcore` — the `l`-cofactor numerator (`s_num` of `Qrow_phicert.m`). -/
def Bnum (n k l : ℚ) : ℚ := l ^ 3 * Bcore n k l

/-! ## 3.  ⭑ The cleared polynomial identity ⭑

`Z5CF_CERT.md` §5.4.  This is the whole certificate; everything else in the file is plumbing.
Degrees `(deg_n, deg_k, deg_l) = (27, 11, 13)`; 3798 monomials in the normal form. -/

/-- ⭑ **The cleared polynomial identity** ⭑ (`work/Z5CF_CERT.md` §5.4) — the *whole* content of
the Q-row certificate, as a named proposition.  Everything else in this file is plumbing and is
proved unconditionally; every theorem below that needs the certificate carries `KeyPoly` as an
explicit hypothesis, in the style of `BZClosedForm.PhatSum_eq_Phat_of_rec`.

    D*·Σ_i c_i(n)P_i(n,k,l)
      = U₁·A(n,k+1,l) − U₂·A(n,k,l) + U₃·B(n,k,l+1) − U₄·B(n,k,l)

It is an identity in `ℤ[n,k,l]` of degrees `(deg_n, deg_k, deg_l) = (27,11,13)` with 3798
monomials in its normal form and integer coefficients up to 76 bits.  See `work/LEAN_QROW.md`
for why it is *not* discharged here. -/
def KeyPoly : Prop :=
  ∀ n k l : ℚ,
    Dstar n k l * (cq0 n * PP0 n k l + cq1 n * PP1 n k l + cq2 n * PP2 n k l + cq3 n * PP3 n k l)
      = U1 n k l * Anum n (k + 1) l - U2 n k l * Anum n k l
        + U3 n k l * Bnum n k (l + 1) - U4 n k l * Bnum n k l

