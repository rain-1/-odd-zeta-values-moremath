/-! ### 3.2  ⭑ The three kernel computations ⭑

`work/LEAN_QROW.md` §16.2: the kernel's `whnf` cache is released **per declaration**, so the
whole certificate in one `decide` reaches 12.7 GB, while the same work split three ways peaks
at the largest single step.  The split points are chosen by the measured cost model
(≈3.5 KB of cache per produced monomial-cell): the `k`-shift of the 1133-monomial `A`-table is
the single most expensive operation and gets its own declaration. -/

set_option maxRecDepth 4000 in
/-- **Step 1/3** — the `k`-shift of the `A`-table. -/
theorem hAK : substK AmidP = AKP := by decide +kernel

set_option maxRecDepth 4000 in
/-- **Step 2/3** — the left-hand side, `D*` applied one sparse factor at a time. -/
theorem hL :
    pmul (ppow fl1 3) (pmul (ppow fk1 3) (pmul fkl2 (pmul fkl1 (pmul fnl3 (pmul fnl2
      (pmul (ppow fn2 2) (pmul (ppow fn1 2)
        (padd (padd (pmul cq0P PP0P) (pmul cq1P PP1P))
              (padd (pmul cq2P PP2P) (pmul cq3P PP3P))))))))))
      = WP := by
  decide +kernel

set_option maxRecDepth 4000 in
/-- **Step 3/3** — the right-hand side, the four `U_i`-chains and their two merges. -/
theorem hR :
    psub (padd
        (psub (pmul fnkl1 (pmul fnk1 (pmul (ppow fa3 2) (pmul (ppow fl1 3)
                (pmul (ppow fk1 3) (pmul fnl1 AKP))))))
              (pmul fkl2 (pmul (ppow fl1 3) (pmul (ppow fk1 3)
                (pmul (ppow pK 3) (pmul fnl1 AmidP))))))
        (pmul fnl2 (pmul fnkl1 (pmul fnl1 (pmul (ppow fb3 2) (pmul (ppow fk1 3)
          (pmul (ppow fl1 3) (pmul KfacP (substL BmidP))))))))) 
        (pmul fnl3 (pmul fkl2 (pmul (ppow fl1 3) (pmul (ppow fk1 3)
          (pmul (ppow pL 3) (pmul KfacP BmidP))))))
      = WP := by
  decide +kernel

/-- `D*` regrouped to match `hL`'s multiplication order.  Its one degree-14 `ring` call is kept
in its own lemma so it is never multiplied by further atoms. -/
theorem Dstar_group (n k l : ℚ) :
    Dstar n k l
      = (l + 1) ^ 3 * ((k + 1) ^ 3 * ((k + l + 2) * ((k + l + 1)
          * ((n + l + 3) * ((n + l + 2) * ((n + 2) ^ 2 * (n + 1) ^ 2)))))) := by
  simp only [Dstar]; ring

theorem eval_WP_lhs (n k l : ℚ) :
    eval WP n k l
      = Dstar n k l
        * (cq0 n * PP0 n k l + cq1 n * PP1 n k l + cq2 n * PP2 n k l + cq3 n * PP3 n k l) := by
  rw [← hL, Dstar_group]
  simp only [eval_pmul, eval_padd, eval_ppow, eval_fn1, eval_fn2, eval_fnl2, eval_fnl3,
    eval_fkl1, eval_fkl2, eval_fk1, eval_fl1, eval_cq0P, eval_cq1P, eval_cq2P, eval_cq3P,
    eval_PP0P, eval_PP1P, eval_PP2P, eval_PP3P]
  ring

theorem eval_WP_rhs (n k l : ℚ) :
    eval WP n k l
      = U1 n k l * Anum n (k + 1) l - U2 n k l * Anum n k l
        + U3 n k l * Bnum n k (l + 1) - U4 n k l * Bnum n k l := by
  rw [← hR, ← hAK]
  simp only [eval_psub, eval_padd, eval_pmul, eval_ppow, eval_substK, eval_substL,
    eval_fnkl1, eval_fnk1, eval_fa3, eval_fb3, eval_fl1, eval_fk1, eval_fnl1, eval_fnl2,
    eval_fnl3, eval_fkl2, eval_pK, eval_pL, eval_KfacP,
    U1, U2, U3, U4, Anum, Acore, Amid, Bnum, Bcore, Bmid, Kfac]
  ring

/-- ⭑ **`KeyPoly`, discharged** ⭑ -/
theorem key_poly : KeyPoly := fun n k l => (eval_WP_lhs n k l).symm.trans (eval_WP_rhs n k l)

end Cert

/-! ## 4.  Positivity of every denominator

`LEAN_Z5_SCAFFOLD` §5.2: over the base `Φ` every denominator factor is strictly positive on the
whole range `n,k,l ≥ 0`, so there is no interior pole and no `0/0` anywhere below. -/

theorem PP3_pos (n k l : ℕ) : 0 < PP3 (n : ℚ) (k : ℚ) (l : ℚ) := by
  simp only [PP3, X1, X2, X3]; positivity

theorem Dr_pos (n k l : ℕ) : 0 < Dr (n : ℚ) (k : ℚ) (l : ℚ) := by
  simp only [Dr]; positivity

theorem Ds_pos (n k l : ℕ) : 0 < Ds (n : ℚ) (k : ℚ) (l : ℚ) := by
  simp only [Ds]; positivity

theorem Dstar_pos (n k l : ℕ) : 0 < Dstar (n : ℚ) (k : ℚ) (l : ℚ) := by
  simp only [Dstar]; positivity

theorem PPDr_ne (n k l : ℕ) : PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dr (n : ℚ) (k : ℚ) (l : ℚ) ≠ 0 :=
  (mul_pos (PP3_pos n k l) (Dr_pos n k l)).ne'

theorem PPDs_ne (n k l : ℕ) : PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Ds (n : ℚ) (k : ℚ) (l : ℚ) ≠ 0 :=
  (mul_pos (PP3_pos n k l) (Ds_pos n k l)).ne'

theorem PPDstar_ne (n k l : ℕ) :
    PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ) ≠ 0 :=
  (mul_pos (PP3_pos n k l) (Dstar_pos n k l)).ne'

/-- The same at `k+1`, with the cast already pushed — the form `Rq_next` needs. -/
theorem PPDr_k_ne (n k l : ℕ) :
    PP3 (n : ℚ) ((k : ℚ) + 1) (l : ℚ) * Dr (n : ℚ) ((k : ℚ) + 1) (l : ℚ) ≠ 0 := by
  have h := PPDr_ne n (k + 1) l
  push_cast at h
  exact h

/-- The same at `l+1`. -/
theorem PPDs_l_ne (n k l : ℕ) :
    PP3 (n : ℚ) (k : ℚ) ((l : ℚ) + 1) * Ds (n : ℚ) (k : ℚ) ((l : ℚ) + 1) ≠ 0 := by
  have h := PPDs_ne n k (l + 1)
  push_cast at h
  exact h

/-! ## 5.  The five `T`-shift facts, in the cascaded grouping of `BZClosedForm` §2.1 -/

/-- `T(n,k,l)·P₃ = T(n+3,k,l)·P₀` — literally `T_shift_n3`. -/
theorem F0 (n k l : ℕ) :
    (T n k l : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
      = (T (n + 3) k l : ℚ) * PP0 (n : ℚ) (k : ℚ) (l : ℚ) := by
  simp only [PP3, PP0, X1, X2, X3, Y1, Y2, Y3]
  exact (T_shift_n3 n k l).symm

/-- `T(n+1,k,l)·P₃ = T(n+3,k,l)·P₁` — `T_shift_n2` at `n+1`, absorbed by the block `X1`. -/
theorem F1 (n k l : ℕ) :
    (T (n + 1) k l : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
      = (T (n + 3) k l : ℚ) * PP1 (n : ℚ) (k : ℚ) (l : ℚ) := by
  have h := T_shift_n2 (n + 1) k l
  rw [show n + 1 + 2 = n + 3 from rfl] at h
  push_cast at h
  simp only [PP3, PP1, X2, X3, Y2, Y3]
  linear_combination (-(X1 (n : ℚ) (k : ℚ) (l : ℚ))) * h

/-- `T(n+2,k,l)·P₃ = T(n+3,k,l)·P₂` — `T_shift_n` at `n+2`, absorbed by `X1·X2`. -/
theorem F2 (n k l : ℕ) :
    (T (n + 2) k l : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
      = (T (n + 3) k l : ℚ) * PP2 (n : ℚ) (k : ℚ) (l : ℚ) := by
  have h := T_shift_n (n + 2) k l
  rw [show n + 2 + 1 = n + 3 from rfl] at h
  push_cast at h
  simp only [PP3, PP2, X3, Y3]
  linear_combination (-(X1 (n : ℚ) (k : ℚ) (l : ℚ) * X2 (n : ℚ) (k : ℚ) (l : ℚ))) * h

/-- The `k`-step of the base, `T_shift_k` at `n+3`. -/
theorem Fk (n k l : ℕ) :
    (T (n + 3) (k + 1) l : ℚ) * (((k : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1))
      = (T (n + 3) k l : ℚ)
        * (((n : ℚ) + (k : ℚ) + 4) * ((n : ℚ) + 3 - (k : ℚ)) ^ 2
            * ((n : ℚ) + (k : ℚ) + (l : ℚ) + 4)) := by
  have h := T_shift_k (n + 3) k l
  push_cast at h
  linear_combination h

/-- The `l`-step of the base, `T_shift_l` at `n+3`. -/
theorem Fl (n k l : ℕ) :
    (T (n + 3) k (l + 1) : ℚ) * (((l : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1))
      = (T (n + 3) k l : ℚ)
        * (((n : ℚ) + (l : ℚ) + 4) * ((n : ℚ) + 3 - (l : ℚ)) ^ 2
            * ((n : ℚ) + (k : ℚ) + (l : ℚ) + 4)) := by
  have h := T_shift_l (n + 3) k l
  push_cast at h
  linear_combination h

/-! ## 6.  Denominator shift relations (degree ≤ 14 `ring` calls) -/

theorem PP3_shift_k (n k l : ℚ) :
    PP3 n (k + 1) l * ((n + k + 1) * (n + k + l + 1))
      = PP3 n k l * ((n + k + 4) * (n + k + l + 4)) := by
  simp only [PP3, X1, X2, X3]; ring

theorem PP3_shift_l (n k l : ℚ) :
    PP3 n k (l + 1) * ((n + l + 1) * (n + k + l + 1))
      = PP3 n k l * ((n + l + 4) * (n + k + l + 4)) := by
  simp only [PP3, X1, X2, X3]; ring

theorem Dstar_eq_Dr (n k l : ℚ) : Dstar n k l = Dr n k l * U2 n k l := by
  simp only [Dstar, Dr, U2]; ring

theorem Dstar_eq_Ds (n k l : ℚ) : Dstar n k l = Ds n k l * U4 n k l := by
  simp only [Dstar, Ds, U4]; ring

theorem Dstar_eq_Drk (n k l : ℚ) :
    Dstar n k l = Dr n (k + 1) l * ((k + 1) ^ 3 * (l + 1) ^ 3 * (k + l + 1)) := by
  simp only [Dstar, Dr]; ring

theorem Dstar_eq_Dsl (n k l : ℚ) :
    Dstar n k l = Ds n k (l + 1) * ((k + 1) ^ 3 * (l + 1) ^ 3 * (k + l + 1) * (n + l + 2)) := by
  simp only [Dstar, Ds]; ring

/-! ## 7.  The WZ pair -/

/-- `R(n,k,l) = Φ(n,k,l)·ρ(n,k,l) = T(n+3,k,l)·A(n,k,l)/(P₃·D_r)`. -/
def Rq (n k l : ℕ) : ℚ :=
  (T (n + 3) k l : ℚ) * Anum (n : ℚ) (k : ℚ) (l : ℚ)
    / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dr (n : ℚ) (k : ℚ) (l : ℚ))

/-- `S(n,k,l) = Φ(n,k,l)·σ(n,k,l) = T(n+3,k,l)·B(n,k,l)/(P₃·D_s)`. -/
def Sq (n k l : ℕ) : ℚ :=
  (T (n + 3) k l : ℚ) * Bnum (n : ℚ) (k : ℚ) (l : ℚ)
    / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Ds (n : ℚ) (k : ℚ) (l : ℚ))

/-- **(B-bot-k)** — free, from the factor `k³` of `A`. -/
theorem Rq_bot (n l : ℕ) : Rq n 0 l = 0 := by simp [Rq, Anum]

/-- **(B-top-k)** — free, from `C(n+3,n+4) = 0`. -/
theorem Rq_top (n l : ℕ) : Rq n (n + 4) l = 0 := by
  simp [Rq, T_eq_zero_of_lt_left (show n + 3 < n + 4 by omega)]

/-- **(B-bot-l)** — free, from the factor `l³` of `B`. -/
theorem Sq_bot (n k : ℕ) : Sq n k 0 = 0 := by simp [Sq, Bnum]

/-- **(B-top-l)**. -/
theorem Sq_top (n k : ℕ) : Sq n k (n + 4) = 0 := by
  simp [Sq, T_eq_zero_of_lt_right (show n + 3 < n + 4 by omega)]

/-! ## 8.  The five terms over the common denominator `P₃·D*` -/

theorem E_eq (n k l : ℕ) :
    cc0 n * (T n k l : ℚ) + cc1 n * (T (n + 1) k l : ℚ) + cc2 n * (T (n + 2) k l : ℚ)
        + cc3 n * (T (n + 3) k l : ℚ)
      = (T (n + 3) k l : ℚ)
          * (Dstar (n : ℚ) (k : ℚ) (l : ℚ)
              * (cq0 (n : ℚ) * PP0 (n : ℚ) (k : ℚ) (l : ℚ)
                + cq1 (n : ℚ) * PP1 (n : ℚ) (k : ℚ) (l : ℚ)
                + cq2 (n : ℚ) * PP2 (n : ℚ) (k : ℚ) (l : ℚ)
                + cq3 (n : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)))
        / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) := by
  rw [eq_div_iff (PPDstar_ne n k l), ccq0, ccq1, ccq2, ccq3]
  linear_combination
    (Dstar (n : ℚ) (k : ℚ) (l : ℚ) * cq0 (n : ℚ)) * F0 n k l
      + (Dstar (n : ℚ) (k : ℚ) (l : ℚ) * cq1 (n : ℚ)) * F1 n k l
      + (Dstar (n : ℚ) (k : ℚ) (l : ℚ) * cq2 (n : ℚ)) * F2 n k l

theorem Rq_here (n k l : ℕ) :
    Rq n k l = (T (n + 3) k l : ℚ) * (U2 (n : ℚ) (k : ℚ) (l : ℚ) * Anum (n : ℚ) (k : ℚ) (l : ℚ))
      / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) := by
  rw [Rq, div_eq_div_iff (PPDr_ne n k l) (PPDstar_ne n k l), Dstar_eq_Dr]
  ring

theorem Sq_here (n k l : ℕ) :
    Sq n k l = (T (n + 3) k l : ℚ) * (U4 (n : ℚ) (k : ℚ) (l : ℚ) * Bnum (n : ℚ) (k : ℚ) (l : ℚ))
      / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) := by
  rw [Sq, div_eq_div_iff (PPDs_ne n k l) (PPDstar_ne n k l), Dstar_eq_Ds]
  ring

theorem Rq_next (n k l : ℕ) :
    Rq n (k + 1) l
      = (T (n + 3) k l : ℚ)
          * (U1 (n : ℚ) (k : ℚ) (l : ℚ) * Anum (n : ℚ) ((k : ℚ) + 1) (l : ℚ))
        / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) := by
  have hck : (((k : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1)) ≠ 0 := by positivity
  rw [Rq]
  push_cast
  rw [div_eq_div_iff (PPDr_k_ne n k l) (PPDstar_ne n k l)]
  refine mul_right_cancel₀ hck ?_
  simp only [U1]
  linear_combination
    (Anum (n : ℚ) ((k : ℚ) + 1) (l : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
        * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) * Fk n k l
    + ((T (n + 3) k l : ℚ) * Anum (n : ℚ) ((k : ℚ) + 1) (l : ℚ) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
        * (((n : ℚ) + (k : ℚ) + 4) * ((n : ℚ) + 3 - (k : ℚ)) ^ 2
            * ((n : ℚ) + (k : ℚ) + (l : ℚ) + 4)))
        * Dstar_eq_Drk (n : ℚ) (k : ℚ) (l : ℚ)
    - ((T (n + 3) k l : ℚ) * Anum (n : ℚ) ((k : ℚ) + 1) (l : ℚ)
        * Dr (n : ℚ) ((k : ℚ) + 1) (l : ℚ) * ((n : ℚ) + 3 - (k : ℚ)) ^ 2
        * (((k : ℚ) + 1) ^ 3 * ((l : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1)))
        * PP3_shift_k (n : ℚ) (k : ℚ) (l : ℚ)

theorem Sq_next (n k l : ℕ) :
    Sq n k (l + 1)
      = (T (n + 3) k l : ℚ)
          * (U3 (n : ℚ) (k : ℚ) (l : ℚ) * Bnum (n : ℚ) (k : ℚ) ((l : ℚ) + 1))
        / (PP3 (n : ℚ) (k : ℚ) (l : ℚ) * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) := by
  have hcl : (((l : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1)) ≠ 0 := by positivity
  rw [Sq]
  push_cast
  rw [div_eq_div_iff (PPDs_l_ne n k l) (PPDstar_ne n k l)]
  refine mul_right_cancel₀ hcl ?_
  simp only [U3]
  linear_combination
    (Bnum (n : ℚ) (k : ℚ) ((l : ℚ) + 1) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
        * Dstar (n : ℚ) (k : ℚ) (l : ℚ)) * Fl n k l
    + ((T (n + 3) k l : ℚ) * Bnum (n : ℚ) (k : ℚ) ((l : ℚ) + 1) * PP3 (n : ℚ) (k : ℚ) (l : ℚ)
        * (((n : ℚ) + (l : ℚ) + 4) * ((n : ℚ) + 3 - (l : ℚ)) ^ 2
            * ((n : ℚ) + (k : ℚ) + (l : ℚ) + 4)))
        * Dstar_eq_Dsl (n : ℚ) (k : ℚ) (l : ℚ)
    - ((T (n + 3) k l : ℚ) * Bnum (n : ℚ) (k : ℚ) ((l : ℚ) + 1)
        * Ds (n : ℚ) (k : ℚ) ((l : ℚ) + 1) * ((n : ℚ) + 3 - (l : ℚ)) ^ 2
        * (((k : ℚ) + 1) ^ 3 * ((l : ℚ) + 1) ^ 3 * ((k : ℚ) + (l : ℚ) + 1) * ((n : ℚ) + (l : ℚ) + 2)))
        * PP3_shift_l (n : ℚ) (k : ℚ) (l : ℚ)

/-! ## 9.  ⭑ The telescoping identity ⭑ -/

/-- **(★)**  `Σ_{i=0}^{3} c_i(n)·T(n+i,k,l) = Δ_k R + Δ_l S`, for **all** `n,k,l : ℕ`,
given the certificate identity. -/
theorem star (n k l : ℕ) :
    cc0 n * (T n k l : ℚ) + cc1 n * (T (n + 1) k l : ℚ) + cc2 n * (T (n + 2) k l : ℚ)
        + cc3 n * (T (n + 3) k l : ℚ)
      = (Rq n (k + 1) l - Rq n k l) + (Sq n k (l + 1) - Sq n k l) := by
  rw [E_eq, Rq_next, Rq_here, Sq_next, Sq_here, div_sub_div_same, div_sub_div_same, ← add_div]
  congr 1
  linear_combination (T (n + 3) k l : ℚ) * key_poly (n : ℚ) (k : ℚ) (l : ℚ)

/-! ## 10.  Summation: `Q` is annihilated by `L_BZ` -/

theorem QSum_bzrec : BZRec QSum := by
  intro n
  have inner : ∀ k : ℕ,
      cc0 n * (∑ l ∈ range (n + 4), (T n k l : ℚ))
        + cc1 n * (∑ l ∈ range (n + 4), (T (n + 1) k l : ℚ))
        + cc2 n * (∑ l ∈ range (n + 4), (T (n + 2) k l : ℚ))
        + cc3 n * (∑ l ∈ range (n + 4), (T (n + 3) k l : ℚ))
      = (∑ l ∈ range (n + 4), (Rq n (k + 1) l - Rq n k l))
        + (∑ l ∈ range (n + 4), (Sq n k (l + 1) - Sq n k l)) := by
    intro k
    rw [Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
      ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib,
      ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl fun l _ => star n k l
  rw [QSum_eq_sum_range (n := n) (N := n + 4) (by omega),
    QSum_eq_sum_range (n := n + 1) (N := n + 4) (by omega),
    QSum_eq_sum_range (n := n + 2) (N := n + 4) (by omega),
    QSum_eq_sum_range (n := n + 3) (N := n + 4) (by omega),
    Finset.mul_sum, Finset.mul_sum, Finset.mul_sum, Finset.mul_sum,
    ← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  rw [Finset.sum_congr rfl fun k _ => inner k]
  rw [Finset.sum_add_distrib]
  have hR : ∑ k ∈ range (n + 4), ∑ l ∈ range (n + 4), (Rq n (k + 1) l - Rq n k l) = 0 := by
    rw [Finset.sum_comm]
    refine Finset.sum_eq_zero fun l _ => ?_
    rw [Finset.sum_range_sub (fun k => Rq n k l) (n + 4), Rq_top, Rq_bot, sub_zero]
  have hS : ∑ k ∈ range (n + 4), ∑ l ∈ range (n + 4), (Sq n k (l + 1) - Sq n k l) = 0 := by
    refine Finset.sum_eq_zero fun k _ => ?_
    rw [Finset.sum_range_sub (fun l => Sq n k l) (n + 4), Sq_top, Sq_bot, sub_zero]
  rw [hR, hS, add_zero]

/-! ## 11.  The `Q` row as the sequence defined by `L_BZ` -/

/-- The Brown–Zudilin `Q` row, *defined* by `L_BZ` with `Q₀ = 1, Q₁ = 21, Q₂ = 2989`. -/
def QBZ : ℕ → ℚ
  | 0 => 1
  | 1 => 21
  | 2 => 2989
  | (n + 3) => -(cc0 n * QBZ n + cc1 n * QBZ (n + 1) + cc2 n * QBZ (n + 2)) / cc3 n

@[simp] theorem QBZ_zero : QBZ 0 = 1 := rfl
@[simp] theorem QBZ_one : QBZ 1 = 21 := rfl
@[simp] theorem QBZ_two : QBZ 2 = 2989 := rfl

theorem QBZ_bzrec : BZRec QBZ := by
  intro n
  have hne := cc3_ne n
  have h : QBZ (n + 3) = -(cc0 n * QBZ n + cc1 n * QBZ (n + 1) + cc2 n * QBZ (n + 2)) / cc3 n :=
    rfl
  rw [h]
  field_simp
  ring

theorem QSum_zero : QSum 0 = 1 := by
  rw [QSum_eq_Q]; norm_num [show Q 0 = 1 from by decide]

theorem QSum_one : QSum 1 = 21 := by
  rw [QSum_eq_Q]; norm_num [show Q 1 = 21 from by decide]

theorem QSum_two : QSum 2 = 2989 := by
  rw [QSum_eq_Q]; norm_num [show Q 2 = 2989 from by decide]

/-- **MAIN COROLLARY.**  `Σ_{k,l=0}^{n} T(n,k,l)` is the sequence defined by `L_BZ` and
`Q₀ = 1, Q₁ = 21, Q₂ = 2989`. -/
theorem QSum_eq_QBZ (n : ℕ) : QSum n = QBZ n :=
  eq_of_BZRec QSum_bzrec QBZ_bzrec QSum_zero QSum_one QSum_two n

/-- **MAIN THEOREM, on the integer row.**  The Brown–Zudilin numbers `Q_n` of
`BrownZudilin.lean` are annihilated by the certified order-3 operator `L_BZ`. -/
theorem Q_bzrec : BZRec (fun n => (Q n : ℚ)) := by
  have h : (fun n => (Q n : ℚ)) = QSum := funext fun n => (QSum_eq_Q n).symm
  rw [h]; exact QSum_bzrec

/-- The same, written out. -/
theorem Q_rec (n : ℕ) :
    cc0 n * (Q n : ℚ) + cc1 n * (Q (n + 1) : ℚ) + cc2 n * (Q (n + 2) : ℚ)
      + cc3 n * (Q (n + 3) : ℚ) = 0 := Q_bzrec n

theorem Q_eq_QBZ (n : ℕ) : (Q n : ℚ) = QBZ n := by
  rw [← QSum_eq_Q]; exact QSum_eq_QBZ n

