      b = 68*t**2/5 - 187*t/20 + 17/32   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = -34*t**2/5 + 17*t/5 - 17/40   <- s2 (fold-singular if != 0)
      d = -t**2 + 7*t/2 - 17/32   <- s*s2
  E4(q)-E4(q^6)  (deg 2, nullspace dim 1):
      w = -9*t**2/10 + 9*t/32 - 9/640
