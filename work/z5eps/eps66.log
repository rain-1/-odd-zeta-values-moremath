PART 3: exact decomposition of every I_S over the (Z/2)^2 cover
  ansatz: w(t)*I_S = a + b*s + c*s2 + d*s*s2,
  s = sqrt(1-4t) [branch at 1/4], s2 = sqrt(1-16t) [branch at
  the fold 1/16]; poly coefficients.  Kernel of C_{1/4} within
  fold-regular sources  <=>  b = c = d = 0  <=>  I_S rational.
  f6(q)  (deg 2, nullspace dim 1):
      w = -128*t**2 + 40*t - 2
      a = 0
      b = 16*t**2 - t   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = 0   <- s2 (fold-singular if != 0)
      d = -t   <- s*s2
  f*  (deg 2, nullspace dim 2):
      w = 4*t - 1
      a = 0
      b = -t   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = 0   <- s2 (fold-singular if != 0)
      d = 0   <- s*s2
  f6(q^2)  (deg 2, nullspace dim 1):
      w = -512*t**2 + 160*t - 8
      a = 0
      b = -16*t**2 + t   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = 0   <- s2 (fold-singular if != 0)
      d = -t   <- s*s2
  f6(q^4) [level-24 oldspace probe]: NOT in Q(t)[s,s2] up to deg 14 -- outside the level-12 AL tower (record).
  E4(q)-E4(q^2)  (deg 2, nullspace dim 1):
      w = 4*t**2/15 - t/12 + 1/240
      a = -8*t**2 + 5*t/2 - 1/8
      b = -4*t**2 + 11*t/4 - 5/32   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = 2*t**2 - t + 1/8   <- s2 (fold-singular if != 0)
      d = 5/32 - t   <- s*s2
  E4(q)-E4(q^3)  (deg 2, nullspace dim 1):
      w = -9*t**2/10 + 9*t/32 - 9/640
      a = 8*t**3 + 63*t**2/2 - 21*t/2 + 17/32
      b = 12*t**2 - 33*t/4 + 15/32   <- s-branch (kills C_{1/4}-kernel if != 0)
      c = -15*t**2/2 + 15*t/4 - 15/32   <- s2 (fold-singular if != 0)
      d = -t**2 + 7*t/2 - 17/32   <- s*s2
  E4(q)-E4(q^4)  (deg 2, nullspace dim 1):
      w = -64*t**2/75 + 4*t/15 - 1/75
