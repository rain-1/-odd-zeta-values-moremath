/*
  Triangular harmonic-Gosper search for the compact Cooper s_7 companion.
  The formal letters are
    x=H_k, y=H_(n-k), z=H_(2k), x2=H_k^(2),
    y2=H_(n-k)^(2), n2=H_n^(2).
*/
display2d:false$
load("zeilberger")$

S:binomial(n,k)^2*binomial(n+k,k)*binomial(2*k,n)$
rk:shiftQuo(S,k)$
rn:shiftQuo(S,n)$

w(x,y,z,x2,y2,n2):=
 (3*(x-y)*(2*z-3*x+y)+5*x2+2*n2-3*y2)/28$

w0:w(x,y,z,x2,y2,n2)$
w1:w(x,y+1/(n+1-k),z,x2,y2+1/(n+1-k)^2,n2+1/(n+1)^2)$
w2:w(x,y+1/(n+1-k)+1/(n+2-k),z,x2,
     y2+1/(n+1-k)^2+1/(n+2-k)^2,
     n2+1/(n+1)^2+1/(n+2)^2)$

rn1:subst(n=n+1,rn)$
q0:-3*(n+1)*(3*n+2)*(3*n+4)$
q1:-(2*n+3)*(13*n^2+39*n+30)$
q2:(n+2)^3$
E:ratsimp(q0*w0+q1*rn*w1+q2*rn*rn1*w2)$

/* k -> k+1 on the harmonic alphabet. */
kshift(expr):=subst(
 [x=x+1/(k+1),
  y=y-1/(n-k),
  z=z+1/(2*k+1)+1/(2*k+2),
  x2=x2+1/(k+1)^2,
  y2=y2-1/(n-k)^2],
 subst(k=k+1,expr))$

deltapsi(expr):=ratsimp(rk*kshift(expr)-expr)$

/* Coefficient of a formal monomial, with all other letters set to zero. */
letters:[x,y,z,x2,y2,n2]$
cmono(expr,mon):=block([q:expand(expr),vs],
  vs:listofvars(mon),
  for vv in vs do q:coeff(q,vv,hipow(mon,vv)),
  subst(makelist(letters[i]=0,i,1,length(letters)),q))$

top:[x^2,x*y,x*z,y^2,y*z,x2,y2,n2]$
zc:k^2*(n-2*k)*(n-2*k+1)
 *(7*n^3-26*k*n^2+39*n^2+15*k^2*n-91*k*n+72*n
   +22*k^2-78*k+44)/((n-k+1)^2*(n-k+2)^2)$
psi:zc*w0$
R:ratsimp(E-deltapsi(psi))$

print("CHECK top remainder coefficients =",
 makelist(factor(cmono(R,top[i])),i,1,length(top)))$

for mon in [x,y,z] do block([t,g],
  t:factor(cmono(R,mon)),
  print("LINEAR",mon,"target =",t),
  if t#0 then (
    g:Gosper(S*t,k),
    print("  Gosper =",g),
    if g=NO_HYP_SOL or g=NON_HYPERGEOMETRIC then quit(),
    psi:psi+ratsimp(g*t)*mon,
    R:ratsimp(E-deltapsi(psi))
  ))$

print("CHECK linear remainder coefficients =",
 makelist(factor(cmono(R,[x,y,z][i])),i,1,3))$

const:factor(subst([x=0,y=0,z=0,x2=0,y2=0,n2=0],R))$
print("CONSTANT target =",const)$
g0:Gosper(S*const,k)$
print("CONSTANT Gosper =",g0)$
if not (g0=NO_HYP_SOL or g0=NON_HYPERGEOMETRIC) then (
  psi:psi+ratsimp(g0*const),
  R:ratsimp(E-deltapsi(psi)),
  print("FINAL CHECK =",R),
  print("CERTIFICATE RATIO =",factor(psi))
)$
quit();
